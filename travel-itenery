<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Calendar - October & November 2026</title>
    <style>
        :root {
            --primary-pink: #fce4ec;
            --border-color: #e2e8f0;
            --header-bg: #f8fafc;
            --card-bg: #ffffff;
            --accent-color: #db2777;
            --tag-bg: #f1f5f9;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #f8fafc;
            margin: 0;
            padding: 30px;
            color: #1e293b;
        }

        h1 {
            text-align: center;
            font-size: 1.8rem;
            color: #0f172a;
            margin-bottom: 30px;
            letter-spacing: -0.5px;
        }

        .calendar-container {
            display: flex;
            flex-wrap: wrap;
            gap: 40px;
            justify-content: center;
            max-width: 1450px;
            margin: 0 auto;
        }

        .month-card {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            display: flex;
            overflow: hidden;
            width: 660px;
            border: 1px solid #e2e8f0;
        }

        .month-sidebar {
            background-color: var(--primary-pink);
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            text-align: center;
            padding: 24px 12px;
            font-weight: 700;
            font-size: 1.3rem;
            color: #831843;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .month-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .month-grid-wrapper {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
        }

        .day-header {
            background-color: var(--header-bg);
            text-align: center;
            padding: 12px 0;
            font-size: 0.75rem;
            font-weight: 700;
            color: #64748b;
            border-bottom: 1px solid var(--border-color);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .day-cell {
            min-height: 105px;
            border-right: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            padding: 8px;
            position: relative;
            background: #fff;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .day-cell:nth-child(7n) {
            border-right: none;
        }

        .day-number {
            font-size: 0.85rem;
            font-weight: 600;
            color: #334155;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .day-cell.has-events .day-number {
            background-color: #0f172a;
            color: #fff;
        }

        .empty-cell {
            background-color: #fcfcfc;
            border-right: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
        }

        /* Clean Backend-Driven Badges UI */
        .event-stack {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .event-badge {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 3px 6px;
            border-radius: 4px;
            font-size: 0.68rem;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        }

        .badge-travel {
            background-color: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }

        .badge-location {
            background-color: #f0fdf4;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .badge-activity {
            background-color: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .event-badge span.icon {
            font-size: 0.75rem;
        }
    </style>
</head>
<body>

<h1>October & November 2026 Schedule</h1>

<div class="calendar-container">

    <!-- OCTOBER 2026 -->
    <div class="month-card">
        <div class="month-sidebar">October</div>
        <div class="month-content">
            <div class="month-grid-wrapper">
                <div class="day-header">Sun</div>
                <div class="day-header">Mon</div>
                <div class="day-header">Tue</div>
                <div class="day-header">Wed</div>
                <div class="day-header">Thu</div>
                <div class="day-header">Fri</div>
                <div class="day-header">Sat</div>
            </div>
            <div class="month-grid-wrapper" id="oct-grid"></div>
        </div>
    </div>

    <!-- NOVEMBER 2026 -->
    <div class="month-card">
        <div class="month-sidebar">November</div>
        <div class="month-content">
            <div class="month-grid-wrapper">
                <div class="day-header">Sun</div>
                <div class="day-header">Mon</div>
                <div class="day-header">Tue</div>
                <div class="day-header">Wed</div>
                <div class="day-header">Thu</div>
                <div class="day-header">Fri</div>
                <div class="day-header">Sat</div>
            </div>
            <div class="month-grid-wrapper" id="nov-grid"></div>
        </div>
    </div>

</div>

<script>
    // Icons configuration
    const icons = {
        travel: "🚂",
        location: "📍",
        activity: "🎯"
    };

    /**
     * BACKEND CONFIGURATION / DATA OBJECT
     * Easily configure your plans here. If a day has no properties, 
     * the calendar cell stays completely blank and clean automatically.
     */
    const octoberData = {
        "4": {
            travel1: "to Patna",
            loc1: "Patna Zoo",
            travel2: "to Delhi"
        },
        "12": {
            activity1: "Swimming",
            loc1: "City Club"
        },
        "20": {
            travel1: "to Jaipur",
            activity1: "Event"
        }
    };

    const novemberData = {
        "5": {
            travel1: "to Agra",
            loc1: "Taj Mahal"
        },
        "14": {
            activity1: "Birthday",
            party: "Family Party"
        },
        "25": {
            travel1: "to Varanasi",
            loc1: "Ghats"
        }
    };

    function buildMonth(gridId, startDayOfWeek, totalDays, dataSet = {}) {
        const grid = document.getElementById(gridId);
        
        // Empty leading padding cells
        for (let i = 0; i < startDayOfWeek; i++) {
            const empty = document.createElement('div');
            empty.className = 'empty-cell';
            grid.appendChild(empty);
        }

        // Populate days of the month
        for (let day = 1; day <= totalDays; day++) {
            const cell = document.createElement('div');
            const dayKey = `${day}`;
            const dayData = dataSet[dayKey];

            if (dayData) {
                cell.className = 'day-cell has-events';
            } else {
                cell.className = 'day-cell';
            }

            const num = document.createElement('div');
            num.className = 'day-number';
            num.innerText = day;
            cell.appendChild(num);

            if (dayData) {
                const stack = document.createElement('div');
                stack.className = 'event-stack';

                // Helper to push badges dynamically
                if (dayData.travel1) {
                    stack.appendChild(createBadge('travel', icons.travel, dayData.travel1));
                }
                if (dayData.travel2) {
                    stack.appendChild(createBadge('travel', icons.travel, dayData.travel2));
                }
                if (dayData.loc1) {
                    stack.appendChild(createBadge('location', icons.location, dayData.loc1));
                }
                if (dayData.loc2) {
                    stack.appendChild(createBadge('location', icons.location, dayData.loc2));
                }
                if (dayData.activity1) {
                    stack.appendChild(createBadge('activity', icons.activity, dayData.activity1));
                }
                if (dayData.party) {
                    stack.appendChild(createBadge('activity', "🎉", dayData.party));
                }

                cell.appendChild(stack);
            }

            grid.appendChild(cell);
        }
    }

    function createBadge(type, iconStr, text) {
        const badge = document.createElement('div');
        badge.className = `event-badge badge-${type}`;
        badge.innerHTML = `<span class="icon">${iconStr}</span><span>${text}</span>`;
        return badge;
    }

    // October 2026 starts on Thursday (index 4), has 31 days
    // November 2026 starts on Sunday (index 0), has 30 days
    window.onload = function() {
        buildMonth('oct-grid', 4, 31, octoberData);
        buildMonth('nov-grid', 0, 30, novemberData);
    };
</script>

</body>
</html>
